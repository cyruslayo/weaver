{
  "name": "weaver",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test && pnpm run test:prototype",
    "test:prototype": "node --experimental-strip-types --test frontend/src/StreamingEngine.test.ts",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2"
  }
}
