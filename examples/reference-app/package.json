{
  "name": "@weaver/reference-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/reference-app.test.js",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@weaver/core": "workspace:*",
    "@weaver/web": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "vite": "^8.2.0"
  }
}
