{
  "name": "@weaver/playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/inspector-model.test.js dist-test/sample.test.js",
    "sample:write": "tsc -p tsconfig.test.json && node scripts/write-sample.mjs",
    "e2e": "pnpm run build && tsc -p tsconfig.e2e.json && playwright test",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => { for (const dir of ['dist', 'dist-test']) rmSync(dir, { recursive: true, force: true }); })\""
  },
  "dependencies": {
    "@cylayo/weaver-core": "workspace:*",
    "@cylayo/weaver-web": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "^8.2.0"
  }
}
