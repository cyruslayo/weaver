{
  "name": "@weaver/cookbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/cookbook.test.js dist/screens/dashboard.test.js",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@cylayo/weaver-core": "workspace:*",
    "@cylayo/weaver-web": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "vite": "^8.2.0"
  }
}
